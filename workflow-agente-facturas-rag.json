    {
      "parameters": {
        "jsCode": "// Valida la respuesta del agente y arma la fila para Google Sheets (sin IA)\nconst CUIT_CLIENTE = '30712345671';\nconst CUENTAS = {\n  '5.1.01': 'Semillas', '5.1.02': 'Fertilizantes', '5.1.03': 'Agroquímicos',\n  '5.1.04': 'Combustibles y lubricantes', '5.1.05': 'Fletes',\n  '5.1.06': 'Reparaciones de maquinaria', '5.1.07': 'Servicios de contratistas',\n  '5.2.01': 'Honorarios profesionales', '5.2.02': 'Servicios públicos', '5.2.03': 'Gastos de oficina'\n};\nconst num = (v) => {\n  if (v === null || v === undefined || v === '') return null;\n  const n = Number(v);\n  return Number.isFinite(n) ? n : null;\n};\n// Convierte importes escritos a la argentina (2.904,00) o con punto (2904.00)\nconst numTexto = (t) => {\n  let x = String(t).trim().replace(/[.,]$/, '');\n  if (x.includes(',') && x.includes('.')) x = x.replace(/\\./g, '').replace(',', '.');\n  else if (x.includes(',')) x = x.replace(',', '.');\n  else if (/^\\d{1,3}(\\.\\d{3})+$/.test(x)) x = x.replace(/\\./g, '');\n  return num(x);\n};\n\n// Error 1: la API del dólar no respondió\nlet dolar = null;\ntry { dolar = num($('Consultar dolar').first().json.venta); } catch (e) { dolar = null; }\n\n// Total leído directamente del PDF, sin IA (última línea que dice \"Total\", no \"Subtotal\")\nlet totalPdf = null;\ntry {\n  const textoPdf = String($('Extract from File').first().json.text ?? '');\n  const encontrados = [...textoPdf.matchAll(/(?<![a-z])total[^0-9\\n]{0,30}([0-9][0-9.,]*)/gi)];\n  if (encontrados.length) totalPdf = numTexto(encontrados[encontrados.length - 1][1]);\n} catch (e) { totalPdf = null; }\n\nreturn $input.all().map((item) => {\n  const motivos = [];\n  const notas = ['Procesada por IA local (Ollama)'];\n\n  // Error 2: el modelo devolvió algo vacío o que no es JSON\n  let f = null;\n  const texto = String(item.json.output ?? '').trim();\n  try {\n    const m = texto.match(/\\{[\\s\\S]*\\}/);\n    f = m ? JSON.parse(m[0]) : null;\n  } catch (e) { f = null; }\n  if (!f) { f = {}; motivos.push('La IA no devolvió una respuesta válida'); }\n\n  const decision = String(f.decision ?? '').toUpperCase();\n  const cuit = String(f.cuit_proveedor ?? '').replace(/\\D/g, '');\n  const moneda = String(f.moneda ?? 'ARS').toUpperCase();\n  const codigo = String(f.codigo_cuenta ?? '').trim();\n\n  // Total: el de la IA, o si lo omitió, el leído del PDF. Si difieren, a revisar.\n  let total = num(f.total);\n  if (total === null && totalPdf !== null) {\n    total = totalPdf;\n    notas.push('Total tomado del PDF (la IA no lo informó)');\n  } else if (total !== null && totalPdf !== null && Math.abs(Math.abs(total) - totalPdf) > 1) {\n    motivos.push('El total de la IA (' + total + ') no coincide con el del PDF (' + totalPdf + ')');\n  }\n\n  // Error 3: controles contables antes de grabar\n  if (cuit.length !== 11) motivos.push('CUIT del proveedor inválido');\n  if (cuit === CUIT_CLIENTE) motivos.push('Se cargó al cliente como proveedor');\n  if (!total) motivos.push('Total vacío o en cero');\n  const partes = ['neto_gravado', 'no_gravado', 'exento', 'iva', 'percepcion_iva', 'percepcion_iibb', 'otros_tributos']\n    .map((k) => num(f[k]) ?? 0);\n  const suma = partes.reduce((a, b) => a + b, 0);\n  if (total && Math.abs(suma - total) > 1) motivos.push('Los importes no suman el total');\n  if (decision !== 'DERIVAR' && !CUENTAS[codigo]) motivos.push('Cuenta inexistente en el plan de cuentas');\n  if (f.confianza && f.confianza !== 'alta') motivos.push('Confianza ' + f.confianza);\n  if (decision === 'REVISAR') motivos.push('El agente pidió revisión: ' + (f.motivo ?? ''));\n\n  let tipoCambio = 1;\n  if (moneda === 'USD') {\n    tipoCambio = dolar;\n    if (!dolar) motivos.push('No se pudo obtener el dólar oficial');\n  }\n  const totalArs = total && tipoCambio ? Math.round(total * tipoCambio * 100) / 100 : null;\n\n  let estado = 'OK';\n  if (decision === 'DERIVAR') estado = 'Derivar a contadora';\n  else if (motivos.length) estado = 'A revisar';\n\n  return { json: {\n    fecha: f.fecha ?? null, tipo_comprobante: f.tipo_comprobante ?? null,\n    punto_venta: f.punto_venta ?? null, numero: f.numero ?? null, cae: f.cae ?? null,\n    cuit_proveedor: cuit || null, razon_social: f.razon_social ?? null, moneda,\n    neto_gravado: num(f.neto_gravado), no_gravado: num(f.no_gravado), exento: num(f.exento),\n    iva: num(f.iva), percepcion_iva: num(f.percepcion_iva), percepcion_iibb: num(f.percepcion_iibb),\n    otros_tributos: num(f.otros_tributos), total, tipo_cambio: tipoCambio, total_ars: totalArs,\n    codigo_cuenta: CUENTAS[codigo] ? codigo : null, cuenta: CUENTAS[codigo] ?? null,\n    confianza: f.confianza ?? null, motivo_ia: f.motivo ?? null,\n    observaciones: notas.join('; '), estado,\n    motivo_revision: motivos.join('; ') || null,\n  } };\n});\n"
      },
